FROM debian:13-slim

# configure utf-8 locale for proper unicode support
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
                    make \
                    vim \
                    curl \
                    wget \
                    git \
                    mc \
                    ripgrep \
                    gpg \
                    gnupg \
                    lsb-release \
                    ca-certificates \
                    jq \
                    sudo \
    && rm -rf /var/lib/apt/lists/* \
              /var/cache/apt/* \
              /var/log/apt/* \
              /var/log/dpkg.log \
              /var/log/alternatives.log \
              /tmp/*

# create non root user to be able to run claude code with --dangerously-skip-permissions key
RUN useradd -m box && \
    echo "box ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/box && \
    chmod 0440 /etc/sudoers.d/box

# install mise
RUN mkdir -p /etc/apt/keyrings && \
    chmod 755 /etc/apt/keyrings && \
    wget -qO - https://mise.jdx.dev/gpg-key.pub | gpg --dearmor | tee /etc/apt/keyrings/mise-archive-keyring.gpg 1> /dev/null && \
    echo "deb [signed-by=/etc/apt/keyrings/mise-archive-keyring.gpg arch=$(dpkg --print-architecture)] https://mise.jdx.dev/deb stable main" | tee /etc/apt/sources.list.d/mise.list && \
    apt-get update -y && \
    apt-get install -y --no-install-recommends mise && \
    rm -rf /var/lib/apt/lists/* \
           /var/cache/apt/* \
           /var/log/apt/* \
           /var/log/dpkg.log \
           /var/log/alternatives.log \
           /tmp/* && \
    echo 'eval "$(mise activate bash)"' >> /home/box/.bashrc && \
    echo 'mise ls --missing --quiet 2>/dev/null | grep -q . && mise install' >> /home/box/.bashrc

USER box

# pre-create directories so volumes inherit correct ownership
RUN mkdir -p /home/box/.local/share/mise /home/box/.cache/mise /home/box/.cache/opencode

WORKDIR /home/box/app

COPY mise.toml /home/box/app/mise.toml
RUN mise trust

# ai agent launchers
ENV PATH="${PATH}:/home/box/.local/bin"
RUN mkdir -p /home/box/.local/bin && \
    printf '#!/bin/bash\nexec /opt/agentbox/bin/claude/$(cat /opt/agentbox/bin/claude/current)/claude "$@"\n' \
        > /home/box/.local/bin/claude && \
    printf '#!/bin/bash\nexec /opt/agentbox/bin/copilot/$(cat /opt/agentbox/bin/copilot/current)/copilot "$@"\n' \
        > /home/box/.local/bin/copilot && \
    printf '#!/bin/bash\nexec /opt/agentbox/bin/codex/$(cat /opt/agentbox/bin/codex/current)/codex "$@"\n' \
        > /home/box/.local/bin/codex && \
    printf '#!/bin/bash\nexec /opt/agentbox/bin/cursor/$(cat /opt/agentbox/bin/cursor/current)/cursor-agent "$@"\n' \
        > /home/box/.local/bin/cursor && \
    printf '#!/bin/bash\nmise exec node -- node /opt/agentbox/bin/gemini/$(cat /opt/agentbox/bin/gemini/current)/bundle/gemini.js "$@"\n' \
        > /home/box/.local/bin/gemini && \
    printf '#!/bin/bash\nexec /opt/agentbox/bin/opencode/$(cat /opt/agentbox/bin/opencode/current)/opencode "$@"\n' \
        > /home/box/.local/bin/opencode && \
    printf '#!/bin/bash\nexec /opt/agentbox/bin/ralphex/$(cat /opt/agentbox/bin/ralphex/current)/ralphex "$@"\n' \
        > /home/box/.local/bin/ralphex && \
    chmod +x /home/box/.local/bin/claude \
             /home/box/.local/bin/copilot \
             /home/box/.local/bin/codex \
             /home/box/.local/bin/cursor \
             /home/box/.local/bin/gemini \
             /home/box/.local/bin/opencode \
             /home/box/.local/bin/ralphex

# aliases with skip-permissions flags
RUN echo 'alias claude="/home/box/.local/bin/claude --dangerously-skip-permissions"' >> /home/box/.bashrc && \
    echo 'alias copilot="/home/box/.local/bin/copilot --allow-all-paths --allow-all-tools"' >> /home/box/.bashrc && \
    echo 'alias codex="/home/box/.local/bin/codex --dangerously-bypass-approvals-and-sandbox"' >> /home/box/.bashrc && \
    echo 'alias cursor="/home/box/.local/bin/cursor --force"' >> /home/box/.bashrc && \
    echo 'alias gemini="/home/box/.local/bin/gemini --yolo"' >> /home/box/.bashrc && \
    echo 'alias opencode="/home/box/.local/bin/opencode"' >> /home/box/.bashrc && \
    echo 'alias ralphex="/home/box/.local/bin/ralphex"' >> /home/box/.bashrc

ENTRYPOINT ["/bin/bash"]
