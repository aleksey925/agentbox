FROM debian:13-slim

# configure utf-8 locale for proper unicode support
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
                    make \
                    vim \
                    curl \
                    wget \
                    git \
                    mc \
                    ripgrep \
                    gpg \
                    gnupg \
                    lsb-release \
                    ca-certificates \
                    jq \
                    sudo \
    && rm -rf /var/lib/apt/lists/* \
              /var/cache/apt/* \
              /var/log/apt/* \
              /var/log/dpkg.log \
              /var/log/alternatives.log \
              /tmp/*

# create non root user to be able to run claude code with --dangerously-skip-permissions key
RUN useradd -m box && \
    echo "box ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/box && \
    chmod 0440 /etc/sudoers.d/box

# install mise
RUN mkdir -p /etc/apt/keyrings && \
    chmod 755 /etc/apt/keyrings && \
    wget -qO - https://mise.jdx.dev/gpg-key.pub | gpg --dearmor | tee /etc/apt/keyrings/mise-archive-keyring.gpg 1> /dev/null && \
    echo "deb [signed-by=/etc/apt/keyrings/mise-archive-keyring.gpg arch=$(dpkg --print-architecture)] https://mise.jdx.dev/deb stable main" | tee /etc/apt/sources.list.d/mise.list && \
    apt-get update -y && \
    apt-get install -y --no-install-recommends mise && \
    rm -rf /var/lib/apt/lists/* \
           /var/cache/apt/* \
           /var/log/apt/* \
           /var/log/dpkg.log \
           /var/log/alternatives.log \
           /tmp/* && \
    echo 'eval "$(mise activate bash)"' >> /home/box/.bashrc && \
    echo 'mise ls --missing --quiet 2>/dev/null | grep -q . && mise install' >> /home/box/.bashrc

USER box

# pre-create directories so volumes inherit correct ownership
RUN mkdir -p /home/box/.local/share/mise \
             /home/box/.local/state/mise \
             /home/box/.cache/mise \
             /home/box/.cache/opencode

WORKDIR /home/box

# ai agent launchers. agentbox-launch reads per-agent flags live from the mounted
# flags file (kept out of the image by design - see CLAUDE.md "Live, not
# baked"); eval gives the user's flag string shell-style word splitting, and
# printf (not a heredoc) keeps the build frontend-agnostic.
ENV PATH="${PATH}:/home/box/.local/bin"
RUN mkdir -p /home/box/.local/bin && \
    L=/home/box/.local/bin/agentbox-launch && \
    printf '#!/bin/bash\n' > "$L" && \
    printf 'harness="$1"; binary="$2"; shift 2\n' >> "$L" && \
    printf 'flags_file="/opt/agentbox/flags/agent-flags"\n' >> "$L" && \
    printf 'pick() { grep -E "$1" "$flags_file" 2>/dev/null | grep -vE "^[[:space:]]*#" | head -n1; }\n' >> "$L" && \
    printf 'extra=()\n' >> "$L" && \
    printf 'if [ -f "$flags_file" ]; then\n' >> "$L" && \
    printf '  line=$(pick "^[[:space:]]*${harness}([[:space:]]|$)")\n' >> "$L" && \
    printf '  [ -z "$line" ] && line=$(pick "^[[:space:]]*[*]([[:space:]]|$)")\n' >> "$L" && \
    printf '  if [ -n "$line" ]; then read -r _ rest <<< "$line"; eval "extra=($rest)"; fi\n' >> "$L" && \
    printf 'fi\n' >> "$L" && \
    printf 'version=$(cat "/opt/agentbox/bin/${harness}/current" 2>/dev/null)\n' >> "$L" && \
    printf 'exec "/opt/agentbox/bin/${harness}/${version}/${binary}" "${extra[@]}" "$@"\n' >> "$L" && \
    chmod +x /home/box/.local/bin/agentbox-launch && \
    printf '#!/bin/bash\nexec /home/box/.local/bin/agentbox-launch claude claude "$@"\n' \
        > /home/box/.local/bin/claude && \
    printf '#!/bin/bash\nexec /home/box/.local/bin/agentbox-launch copilot copilot "$@"\n' \
        > /home/box/.local/bin/copilot && \
    printf '#!/bin/bash\nexec /home/box/.local/bin/agentbox-launch codex codex "$@"\n' \
        > /home/box/.local/bin/codex && \
    printf '#!/bin/bash\nexec /home/box/.local/bin/agentbox-launch cursor cursor-agent "$@"\n' \
        > /home/box/.local/bin/cursor && \
    printf '#!/bin/bash\nexec /home/box/.local/bin/agentbox-launch opencode opencode "$@"\n' \
        > /home/box/.local/bin/opencode && \
    printf '#!/bin/bash\nexec /home/box/.local/bin/agentbox-launch ralphex ralphex "$@"\n' \
        > /home/box/.local/bin/ralphex && \
    chmod +x /home/box/.local/bin/claude \
             /home/box/.local/bin/copilot \
             /home/box/.local/bin/codex \
             /home/box/.local/bin/cursor \
             /home/box/.local/bin/opencode \
             /home/box/.local/bin/ralphex

ENTRYPOINT ["/bin/bash"]
