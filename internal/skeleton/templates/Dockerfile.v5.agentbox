FROM debian:13-slim

# configure utf-8 locale for proper unicode support
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
                    make \
                    vim \
                    curl \
                    wget \
                    git \
                    mc \
                    ripgrep \
                    fd-find \
                    gpg \
                    gnupg \
                    lsb-release \
                    ca-certificates \
                    jq \
                    sudo \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/* \
              /var/cache/apt/* \
              /var/log/apt/* \
              /var/log/dpkg.log \
              /var/log/alternatives.log \
              /tmp/*

# CLAUDE.md "Container capabilities"
RUN useradd -m box && \
    echo "box ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/box && \
    chmod 0440 /etc/sudoers.d/box

# install mise
RUN mkdir -p /etc/apt/keyrings && \
    chmod 755 /etc/apt/keyrings && \
    wget -qO - https://mise.jdx.dev/gpg-key.pub | gpg --dearmor | tee /etc/apt/keyrings/mise-archive-keyring.gpg 1> /dev/null && \
    echo "deb [signed-by=/etc/apt/keyrings/mise-archive-keyring.gpg arch=$(dpkg --print-architecture)] https://mise.jdx.dev/deb stable main" | tee /etc/apt/sources.list.d/mise.list && \
    apt-get update -y && \
    apt-get install -y --no-install-recommends mise && \
    rm -rf /var/lib/apt/lists/* \
           /var/cache/apt/* \
           /var/log/apt/* \
           /var/log/dpkg.log \
           /var/log/alternatives.log \
           /tmp/* && \
    echo 'eval "$(mise activate bash)"' >> /home/box/.bashrc && \
    echo 'mise ls --missing --quiet 2>/dev/null | grep -q . && mise install' >> /home/box/.bashrc && \
    echo 'while IFS= read -r p; do [ -n "$p" ] && [ "$(stat -c %U "$p" 2>/dev/null)" = root ] && sudo chown box:box "$p"; done <<< "$AGENTBOX_MASK_PATHS"' >> /home/box/.bashrc

ENV DISABLE_AUTOUPDATER=1

# ai agent launchers, in root-owned /usr/local/bin so Claude Code's self-update
# can't clobber the wrapper - see CLAUDE.md "Live, not baked". xargs splits the
# flags line shell-style without evaluating it, so it cannot inject commands.
RUN L=/usr/local/bin/agentbox-launch && \
    printf '#!/bin/bash\n' > "$L" && \
    printf 'harness="$1"; binary="$2"; shift 2\n' >> "$L" && \
    printf 'flags_file="/opt/agentbox/flags/agent-flags"\n' >> "$L" && \
    printf 'pick() { grep -E "$1" "$flags_file" 2>/dev/null | grep -vE "^[[:space:]]*#" | head -n1; }\n' >> "$L" && \
    printf 'extra=()\n' >> "$L" && \
    printf 'if [ -f "$flags_file" ]; then\n' >> "$L" && \
    printf '  line=$(pick "^[[:space:]]*${harness}([[:space:]]|$)")\n' >> "$L" && \
    printf '  [ -z "$line" ] && line=$(pick "^[[:space:]]*[*]([[:space:]]|$)")\n' >> "$L" && \
    printf '  if [ -n "$line" ]; then read -r _ rest <<< "$line"; mapfile -t extra < <(xargs -r printf "%%s\\n" <<< "$rest"); fi\n' >> "$L" && \
    printf 'fi\n' >> "$L" && \
    printf 'version=$(cat "/opt/agentbox/bin/${harness}/current" 2>/dev/null)\n' >> "$L" && \
    printf 'exec "/opt/agentbox/bin/${harness}/${version}/${binary}" "${extra[@]}" "$@"\n' >> "$L" && \
    chmod +x /usr/local/bin/agentbox-launch && \
    printf '#!/bin/bash\nexec /usr/local/bin/agentbox-launch claude claude "$@"\n' \
        > /usr/local/bin/claude && \
    printf '#!/bin/bash\nexec /usr/local/bin/agentbox-launch copilot copilot "$@"\n' \
        > /usr/local/bin/copilot && \
    printf '#!/bin/bash\nexec /usr/local/bin/agentbox-launch codex codex "$@"\n' \
        > /usr/local/bin/codex && \
    printf '#!/bin/bash\nexec /usr/local/bin/agentbox-launch cursor cursor-agent "$@"\n' \
        > /usr/local/bin/cursor && \
    printf '#!/bin/bash\nexec /usr/local/bin/agentbox-launch opencode opencode "$@"\n' \
        > /usr/local/bin/opencode && \
    printf '#!/bin/bash\nexec /usr/local/bin/agentbox-launch pi pi "$@"\n' \
        > /usr/local/bin/pi && \
    printf '#!/bin/bash\nexec /usr/local/bin/agentbox-launch ralphex ralphex "$@"\n' \
        > /usr/local/bin/ralphex && \
    chmod +x /usr/local/bin/claude \
             /usr/local/bin/copilot \
             /usr/local/bin/codex \
             /usr/local/bin/cursor \
             /usr/local/bin/opencode \
             /usr/local/bin/pi \
             /usr/local/bin/ralphex

USER box

# pre-create directories so volumes inherit correct ownership. ~/.config is
# created here so it stays box-owned: Docker would otherwise create it as root
# when mounting the nested ~/.config/opencode and ~/.config/ralphex binds, and
# then `mise use -g` could not write ~/.config/mise.
RUN mkdir -p /home/box/.config \
             /home/box/.local/share/mise \
             /home/box/.local/state/mise \
             /home/box/.cache/mise \
             /home/box/.cache/opencode \
             /home/box/go \
             /home/box/.cache/uv

# mise shims on PATH so non-interactive agent shells (`bash -c`, which skip
# ~/.bashrc and its `mise activate`) still resolve mise-managed binaries. this
# is `mise activate bash --shims` baked in - the official headless/CI path.
ENV PATH="/home/box/.local/share/mise/shims:${PATH}:/home/box/.local/bin"

WORKDIR /home/box

ENTRYPOINT ["/bin/bash"]
